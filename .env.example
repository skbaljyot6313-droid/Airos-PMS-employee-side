# docker-compose variable interpolation (this file is read by `docker compose`,
# NOT by the backend — backend env comes from compose `environment:` blocks).

# Local postgres container (leave unset to use these dev defaults)
POSTGRES_DB=mgmt
POSTGRES_USER=mgmt
POSTGRES_PASSWORD=mgmt-dev-password

# Full SQLAlchemy URL override — set this to target an external database
# (e.g. Supabase) instead of the bundled postgres container:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:6543/db
DATABASE_URL=

# Auth — change before exposing beyond localhost
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:3000

# Shared bearer key protecting GET /api/v1/admin/live-locations
LOCATION_SERVICE_API_KEY=

# Baked into the frontend bundle at image build time — must be reachable
# from the browser, not from inside the compose network:
VITE_API_URL=http://localhost:8000/api/v1
