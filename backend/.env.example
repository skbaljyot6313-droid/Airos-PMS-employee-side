APP_NAME="AiROS Employee API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
# OPT-IN: PG idle_in_transaction_session_timeout (ms), per-connection SET.
# 0 = off (default). Skipped on pooler hosts until verified on staging.
DB_IDLE_TX_TIMEOUT_MS=0
# Per-request stage-timing response headers (X-DB-*/X-Redis-*/X-Ext/X-PoolWait).
# Empty = on outside production; set true/false to force.
PERF_HEADERS_ENABLED=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000
REDIS_URL=
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
RUN_EMBEDDED_SCHEDULER=false
RATE_LIMIT_ENABLED=true
STORAGE_BACKEND=s3
MAX_TASK_COMPLETION_IMAGES=10
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Service-to-service auth — shared bearer key for GET /admin/live-locations
# (consumed by the SA backend; employee JWTs are never accepted).
# Unset = that endpoint fails closed with 503.
LOCATION_SERVICE_API_KEY=

# Release management — shared bearer key for POST /mobile/releases*
# (consumed by the CI release pipeline; employee JWTs never accepted).
# Unset = those endpoints fail closed with 503.
RELEASE_MANAGEMENT_API_KEY=

# Centrifugo realtime (optional — unset = realtime disabled, polling only).
# Secrets must equal the SA backend's and the Centrifugo service's values.
CENTRIFUGO_URL=
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_WS_URL=
# Min seconds between Centrifugo location publishes per employee.
LOCATION_PUBLISH_MIN_INTERVAL_SECONDS=8

# Phase-2 perf flags (defaults shown; all optional).
# Consolidated {user,company,zones,shift,unread_count} endpoint.
BOOTSTRAP_ENABLED=true
# Redis user-row cache TTL for get_current_user; 0 disables. A role/
# is_active change by the SA backend takes up to this TTL to take effect.
USER_CACHE_TTL_S=30

# Phase-4 realtime flags (default OFF).
# Optional company:{company_uid} channel carrying ref_version markers
# only; tokens mint only for the caller's own company. See
# docs/perf/centrifugo-proposal.md before enabling.
REALTIME_COMPANY_CHANNEL_ENABLED=false
