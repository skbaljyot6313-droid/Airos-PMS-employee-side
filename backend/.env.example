APP_NAME="AiROS Employee API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000
REDIS_URL=
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
RUN_EMBEDDED_SCHEDULER=false
RATE_LIMIT_ENABLED=true
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_TASK_COMPLETION_IMAGES=10
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Service-to-service auth — shared bearer key for GET /admin/live-locations
# (consumed by the SA backend; employee JWTs are never accepted).
# Unset = that endpoint fails closed with 503.
LOCATION_SERVICE_API_KEY=
